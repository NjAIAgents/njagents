{
  "//": "Zero-setup tier example: tracker and releases only. Every other source is off, and the absent sources lower confidence rather than raise priority. Fill in cloud_id, site and board_id for your own instance.",
  "team": {
    "name": "Zero-setup example",
    "id": "bta"
  },
  "tracker": {
    "project_key": "BTA",
    "instance_id": "REPLACE_WITH_INSTANCE_ID",
    "host": "REPLACE_WITH_TRACKER_HOST",
    "board_id": 0,
    "priority_names": {
      "P1": "Highest",
      "P2": "High",
      "P3": "Medium",
      "P4": "Low"
    },
    "at_risk_labels": [
      "at-risk",
      "renewal",
      "escalation"
    ],
    "voc_destination": "none"
  },
  "sources": {
    "tracker": {
      "mode": "live"
    },
    "releases": {
      "mode": "live"
    },
    "metrics": {
      "mode": "off"
    },
    "warehouse": {
      "mode": "off"
    },
    "code": {
      "mode": "off"
    }
  },
  "release_correlation": {
    "cadence_days": 30,
    "lookback_days": 60,
    "manifest_sources": [
      "tracker_fixversion"
    ],
    "//wiki": "Add 'wiki_release_notes' here and a wiki.space_key once the release-notes space is known."
  },
  "regression": {
    "baseline_days": 7,
    "baseline_method": "rolling_median",
    "spike_ratio": 3.0,
    "deploy_window_hours": 720
  },
  "warehouse": {
    "database": "",
    "schema": "",
    "queries": {}
  },
  "repos": [],
  "routing": {},
  "tool_bindings": {
    "tracker": {
      "get_issue": "gettrackerIssue",
      "search_issues": "searchtrackerIssuesUsingJql"
    },
    "wiki": {
      "get_page": "getwikiPage",
      "list_pages": "getPagesInwikiSpace"
    }
  }
}
