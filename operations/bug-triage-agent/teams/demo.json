{
  "//": "Demo config. Identical rubric to every other team. Only the source modes differ.",
  "team": {
    "name": "Demo (all sources)",
    "id": "demo",
    "default": true,
    "//default": "The shipped default team: used only when nothing else decides (no --team, no ticket project match, no member match, no local config). A local config in triage-teams/ always wins over it."
  },
  "tracker": {
    "project_key": "BUG",
    "instance_id": "demo",
    "priority_names": {
      "P1": "Blocker",
      "P2": "Critical",
      "P3": "Major",
      "P4": "Minor"
    },
    "at_risk_labels": [
      "at-risk",
      "renewal",
      "escalation"
    ],
    "voc_destination": "PRODUCT"
  },
  "sources": {
    "tracker": {
      "mode": "fixture",
      "fixture": "fixtures/tracker"
    },
    "releases": {
      "mode": "fixture",
      "fixture": "fixtures/releases.json"
    },
    "metrics": {
      "mode": "fixture",
      "fixture": "fixtures/metrics"
    },
    "warehouse": {
      "mode": "fixture",
      "fixture": "fixtures/warehouse"
    },
    "code": {
      "mode": "fixture",
      "fixture": "fixtures/code"
    }
  },
  "release_correlation": {
    "cadence_days": 30,
    "lookback_days": 60,
    "manifest_sources": [
      "tracker_fixversion",
      "wiki_release_notes",
      "vcs_tag"
    ],
    "wiki": {
      "space_key": "ENG",
      "page_label": "release-notes",
      "title_pattern": "Release (?<version>\\d{4}\\.\\d{2})"
    },
    "vcs": {
      "org": "example-org",
      "repos": [
        "approvals-api",
        "core-api"
      ],
      "tag_pattern": "v?(?<version>\\d{4}\\.\\d{2})"
    }
  },
  "regression": {
    "baseline_days": 7,
    "baseline_method": "rolling_median",
    "spike_ratio": 3.0,
    "deploy_window_hours": 720
  },
  "warehouse": {
    "database": "EXAMPLE_LAKE",
    "schema": "CURATED",
    "queries": {
      "affected_accounts_core": "SELECT COUNT(DISTINCT account_id) AS affected, COUNT_IF(tier='ENTERPRISE') AS enterprise FROM EXAMPLE_LAKE.CURATED.LATEST_ACCOUNT_ACTIVITY WHERE product_line = 'CORE' AND updated_at >= DATEADD(day, -7, CURRENT_DATE())"
    }
  },
  "repos": [
    {
      "name": "approvals-api",
      "stack": "TypeScript",
      "search_when": "approval and review flows"
    },
    {
      "name": "core-api",
      "stack": "Java",
      "search_when": "core transaction and settlement logic"
    }
  ],
  "routing": {
    "approvals": "Approvals Team",
    "settlements": "Payments Team",
    "reporting": "Reporting Team"
  },
  "output": {
    "reports_dir": "triage-reports",
    "write_report": "always"
  },
  "sla": {
    "fix_within": {
      "P1": "1d",
      "P2": "5d",
      "P3": "30d",
      "P4": "90d"
    },
    "clock": "created",
    "business_days": false
  }
}
