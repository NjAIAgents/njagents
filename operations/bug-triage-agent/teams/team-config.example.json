{
  "//": "Starting point for a team config written by hand. Easier: run /bug-triage-agent:triage-config <team>. Save your copy as triage-teams/<team>.json in your own repo, never in the plugin. Do not copy the rubric or taxonomy: those are shared.",
  "team": {
    "name": "Your Team",
    "id": "your-team",
    "//members": "Optional. Only used to pick a team when no ticket names one. Exact addresses or '*@example.com'.",
    "members": [],
    "default": false
  },
  "tracker": {
    "project_key": "ABC",
    "instance_id": "REPLACE_WITH_INSTANCE_ID",
    "host": "REPLACE_WITH_TRACKER_HOST",
    "priority_names": {
      "P1": "Blocker",
      "P2": "Critical",
      "P3": "Major",
      "P4": "Minor"
    },
    "at_risk_labels": [
      "at-risk"
    ],
    "voc_destination": "none"
  },
  "sources": {
    "tracker": {
      "mode": "live"
    },
    "releases": {
      "mode": "live"
    },
    "metrics": {
      "mode": "off"
    },
    "warehouse": {
      "mode": "off"
    },
    "code": {
      "mode": "off"
    }
  },
  "//zero-setup": "Leave every source except tracker and releases as 'off'. Add a source later by flipping its mode and adding its tool_bindings entry, using tool names found in your session.",
  "tool_bindings": {
    "tracker": {
      "get_issue": "REPLACE_WITH_TOOL_FOUND_IN_SESSION",
      "search_issues": "REPLACE_WITH_TOOL_FOUND_IN_SESSION"
    }
  },
  "release_correlation": {
    "cadence_days": 30,
    "lookback_days": 60,
    "manifest_sources": [
      "tracker_fixversion"
    ]
  },
  "regression": {
    "baseline_days": 7,
    "baseline_method": "rolling_median",
    "spike_ratio": 3.0,
    "deploy_window_hours": 720
  },
  "warehouse": {
    "database": "",
    "schema": "",
    "queries": {}
  },
  "repos": [],
  "routing": {},
  "output": {
    "reports_dir": "triage-reports",
    "write_report": "always",
    "run_trace": "file"
  },
  "queue": {
    "triage_within_hours": {
      "at_risk": 24,
      "default": 72
    },
    "stuck_after_days": 7
  },
  "automation": {
    "enabled": false,
    "trigger": "schedule",
    "schedule": "0 * * * *",
    "max_per_run": 10
  },
  "verification": {
    "enabled": false,
    "runner": "docker",
    "environment": "local",
    "docker": {
      "base_url": "http://localhost:3000",
      "start": "docker compose up -d",
      "stop": "docker compose down",
      "allow_methods": [
        "GET"
      ]
    }
  }
}
